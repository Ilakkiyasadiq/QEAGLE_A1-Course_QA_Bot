PORT=5000
DATABASE_URL=postgres://postgres:12345678@localhost:5432/courseqa

# Embeddings configuration (local Ollama)
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_DIM=768
OLLAMA_EMBED_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Answer composition
COMPOSER_PROVIDER=ollama
OLLAMA_LLM_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:0.5b
OLLAMA_LLM_TEMPERATURE=0.2
OLLAMA_LLM_TOP_P=0.9
# Max total characters from all chunks to include in the LLM prompt
OLLAMA_CONTEXT_CHARS=5000

# Refusal threshold: if top retrieval score is below this, refuse to answer
# Score is computed as 1 / (1 + distance) for L2 distance; higher is more similar
MIN_RELEVANCE_SCORE=0.35


ANSWER_SNIPPET_LEN=1500
CITATION_SPAN_LEN=30000

MIN_RELEVANCE_SCORE=0.05