PORT=5000
DATABASE_URL=postgres://username:password@localhost:5432/courseqa

# Embeddings configuration
# Use 'dummy' (deterministic, local) or 'hf' (Hugging Face Inference API)
EMBEDDINGS_PROVIDER=dummy
# If using HF, set a 768-dim model (default below) and your token
EMBEDDINGS_MODEL=intfloat/multilingual-e5-base
HF_API_TOKEN=your_hf_api_token_here
# The vector dimension must match the DB schema (migrations.sql has VECTOR(768))
EMBEDDINGS_DIM=768
